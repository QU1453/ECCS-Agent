# ============================================================
# 智能体配置槽（所有智能体共用，对应 config.py）
# 复制为 .env 后填写；.env 已被 .gitignore 拦截，绝不入库
# ============================================================

# ---- 槽位 1：API Key（真实密钥只放这里 / 环境变量）----
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ---- 槽位 2：请求地址（本项目默认智谱 GLM；OpenAI 官方则留空）----
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 槽位 3：模型 ID（本项目默认 GLM-5.3-Flash）----
# OPENAI_MODEL=glm-5.3-flash

# ---- 服务配置 ----
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8623
